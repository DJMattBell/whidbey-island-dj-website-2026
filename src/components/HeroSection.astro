---
import Button from "./Button.astro";
---

<section class="relative min-h-[85vh] flex items-center bg-deep-sound overflow-hidden">
  <div class="max-w-4xl mx-auto px-6 text-center py-20">
    <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-hero text-driftwood leading-tight mb-6">
      Your event deserves music
      <br class="hidden md:block" /> that reads the room.
    </h1>
    <p class="font-body text-body text-sea-glass mb-10 max-w-2xl mx-auto leading-relaxed">
      We&rsquo;re a crew of DJs based on Whidbey Island. Weddings, school
      dances, and any event where the music matters more than the DJ&rsquo;s
      ego.
    </p>
    <Button href="/contact" variant="primary" size="lg">
      Tell us about your event
    </Button>
  </div>
</section>
