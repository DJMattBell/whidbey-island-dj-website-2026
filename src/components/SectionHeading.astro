---
interface Props {
  eyebrow?: string;
  heading: string;
  centered?: boolean;
  dark?: boolean;
}

const { eyebrow, heading, centered = false, dark = true } = Astro.props;
---

<div class:list={["mb-10", centered && "text-center"]}>
  {eyebrow && (
    <span class:list={[
      "block font-body text-eyebrow font-semibold tracking-[0.3em] uppercase mb-3",
      dark ? "text-golden-hour" : "text-golden-hour-700",
    ]}>
      {eyebrow}
    </span>
  )}
  <h2 class:list={[
    "font-heading text-3xl md:text-section leading-tight",
    dark ? "text-penn-cove" : "text-penn-cove",
  ]}>
    {heading}
  </h2>
</div>
