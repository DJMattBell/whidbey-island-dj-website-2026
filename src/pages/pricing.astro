---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/Button.astro";
import { formatPrice } from "../lib/format";

const tiers = (await getCollection("pricingTiers")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const allAddons = (await getCollection("addons")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const djAddons = allAddons.filter((a) => a.data.category !== "photobooth");
const photoboothAddons = allAddons.filter((a) => a.data.category === "photobooth");
---

<BaseLayout
  title="Pricing | Whidbey Island DJ Collective"
  description="Transparent DJ pricing for weddings and events on Whidbey Island. $0 upcharges, ever. Real numbers, no surprises."
>
  <!-- Hero -->
  <section class="py-20 md:py-28 lg:py-section bg-deep-sound">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-driftwood leading-tight mb-6">
        $0 upcharges. Forever.
      </h1>
      <p class="font-body text-body text-sea-glass leading-relaxed max-w-2xl mx-auto">
        Real numbers, live on this page — not locked behind a contact form.
        The price you see is the price you pay.
      </p>
    </div>
  </section>

  <!-- Tiers -->
  <section class="py-20 md:py-28 lg:py-section">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {tiers.map((tier) => (
          <div
            class:list={[
              "rounded-lg p-8 flex flex-col",
              tier.data.highlight
                ? "bg-penn-cove text-driftwood ring-2 ring-penn-cove"
                : "bg-driftwood border border-penn-cove/15",
            ]}
            data-reveal
          >
            {tier.data.badge && (
              <span
                class:list={[
                  "self-start font-body text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1 rounded-full mb-4",
                  tier.data.highlight
                    ? "bg-golden-hour text-deep-sound"
                    : "bg-penn-cove/10 text-penn-cove",
                ]}
              >
                {tier.data.badge}
              </span>
            )}
            <h2
              class:list={[
                "font-heading text-2xl leading-tight mb-2",
                tier.data.highlight ? "text-driftwood" : "text-penn-cove",
              ]}
            >
              {tier.data.name}
            </h2>
            <p
              class:list={[
                "font-heading text-4xl mb-4",
                tier.data.highlight ? "text-driftwood" : "text-deep-sound",
              ]}
            >
              {tier.data.priceLabel ?? formatPrice(tier.data.priceCents)}
            </p>
            <p
              class:list={[
                "font-body text-sm leading-relaxed mb-6",
                tier.data.highlight
                  ? "text-driftwood/80"
                  : "text-deep-sound/70",
              ]}
            >
              {tier.data.description}
            </p>
            <ul class="space-y-3 mt-auto mb-8">
              {tier.data.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <span
                    class:list={[
                      "mt-0.5 shrink-0",
                      tier.data.highlight
                        ? "text-golden-hour"
                        : "text-golden-hour",
                    ]}
                    aria-hidden="true"
                  >
                    &check;
                  </span>
                  <span
                    class:list={[
                      "font-body text-sm",
                      tier.data.highlight
                        ? "text-driftwood/90"
                        : "text-deep-sound/80",
                    ]}
                  >
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
            <Button
              href="/contact"
              variant={tier.data.highlight ? "secondary" : "outline"}
              size="md"
            >
              Get started
            </Button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  {djAddons.length > 0 && (
    <section class="py-20 md:py-28 lg:py-section bg-penn-cove/5">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="Add-ons"
          heading="Make it yours."
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12">
          {djAddons.map((addon) => (
            <div class="bg-driftwood rounded-lg p-6 border border-penn-cove/10">
              <div class="flex justify-between items-start gap-4 mb-2">
                <h3 class="font-heading text-xl text-penn-cove">
                  {addon.data.name}
                </h3>
                <span class="font-heading text-xl text-deep-sound whitespace-nowrap">
                  {formatPrice(addon.data.priceCents)}
                </span>
              </div>
              <p class="font-body text-sm text-deep-sound/70 leading-relaxed">
                {addon.data.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Photobooth add-ons -->
  {photoboothAddons.length > 0 && (
    <section class="py-20 md:py-28 lg:py-section">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="Photobooth"
          heading="Add a photobooth to any package."
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12">
          {photoboothAddons.map((addon) => (
            <div class="bg-driftwood rounded-lg p-6 border border-penn-cove/10">
              <div class="flex justify-between items-start gap-4 mb-2">
                <h3 class="font-heading text-xl text-penn-cove">
                  {addon.data.name}
                </h3>
                <span class="font-heading text-xl text-deep-sound whitespace-nowrap">
                  {formatPrice(addon.data.priceCents)}
                </span>
              </div>
              <p class="font-body text-sm text-deep-sound/70 leading-relaxed">
                {addon.data.description}
              </p>
            </div>
          ))}
        </div>
        <div class="text-center mt-10">
          <Button href="/photobooth" variant="outline" size="md">
            Learn more about the photobooth
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20 md:py-28 lg:py-section bg-deep-sound">
    <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
      <h2 class="font-heading text-3xl md:text-section text-driftwood leading-tight mb-4">
        Ready to book?
      </h2>
      <p class="font-body text-body text-sea-glass mb-10">
        Tell us your date and event type. We&rsquo;ll send you a
        straightforward quote — no follow-up calls unless you want them.
      </p>
      <Button href="/contact" variant="primary" size="lg">
        Check availability
      </Button>
    </div>
  </section>
</BaseLayout>
