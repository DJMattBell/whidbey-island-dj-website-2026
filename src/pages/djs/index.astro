---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import CtaSection from "../../components/CtaSection.astro";
import PlaceholderArt from "../../components/PlaceholderArt.astro";
import heroImage from "../../assets/photos/party-moment.jpg";

const djs = (await getCollection("djs")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
---

<BaseLayout
  title="Meet the DJs | Whidbey Island DJ Collective"
  description="Your DJ from day one. Meet the crew behind the Whidbey Island DJ Collective — named DJs who stay with your event from first call to last song."
  transparentNav
>
  <PhotoHero
    image={heroImage}
    alt="DJ focused at the turntables with headphones"
    overlayClass="bg-deep-sound-950/65"
  >
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-8">
      Your DJ from Day One.
    </h1>
    <p class="font-editorial text-lg text-driftwood-200/90 leading-relaxed max-w-xl italic">
      The DJ you talk to is the DJ who shows up. No hand-offs, no strangers, no
      surprises.
    </p>
  </PhotoHero>

  <!-- DJ profiles — full-width editorial blocks -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-5xl mx-auto px-6">
      {djs.map((dj, i) => (
        <a
          href={`/djs/${dj.id}`}
          class="group grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16 items-center py-16 first:pt-0 last:pb-0 border-b border-penn-cove-200 last:border-0"
          data-reveal
        >
          <div
            class:list={[
              "relative rounded-lg overflow-hidden aspect-[4/3] bg-deep-sound",
              i % 2 !== 0 && "md:order-2",
            ]}
          >
            {dj.data.photo ? (
              <Image
                src={dj.data.photo}
                alt={dj.data.name}
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="absolute inset-0 w-full h-full object-cover object-top"
                loading="lazy"
              />
            ) : (
              <PlaceholderArt variant={i % 2 === 0 ? "cool" : "warm"} />
            )}
            <div class="absolute inset-0 bg-deep-sound/30" />
          </div>
          <div>
            <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-2">
              {dj.data.role}
            </p>
            <h2 class="font-heading text-3xl md:text-4xl text-penn-cove mb-4 group-hover:text-madrone transition-colors duration-200">
              {dj.data.name}
            </h2>
            <p class="font-body text-body text-deep-sound-700 leading-relaxed mb-6">
              {dj.data.philosophy}
            </p>
            <div class="flex flex-wrap gap-2">
              {dj.data.specialties.map((s: string) => (
                <span class="font-body text-xs text-penn-cove-600 bg-penn-cove-50 px-3 py-1 rounded">
                  {s}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaSection
    heading="Want to meet your DJ?"
    body="Tell us about your event and we&rsquo;ll match you with the right person."
    buttonText="Get in touch"
  />
</BaseLayout>
