---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import ReviewCard from "../components/ReviewCard.astro";
import Button from "../components/Button.astro";
import heroImage from "../assets/photos/reception-scene.jpg";
import splitImage from "../assets/photos/event-scene-2.jpg";
import sectionBreakImage from "../assets/photos/elegant-table-setup.jpg";

const entry = await getEntry("services", "weddings");
const { Content } = entry ? await render(entry) : { Content: null };

const weddingReviews = await Promise.all(
  (await getCollection("reviews"))
    .filter((r) => r.data.eventType === "wedding")
    .slice(0, 3)
    .map(async (review) => {
      const { Content } = await render(review);
      return { entry: review, Content };
    }),
);
---

<BaseLayout
  title="Weddings | Whidbey Island DJ Collective"
  description="Wedding DJ services on Whidbey Island and the Puget Sound. Transparent pricing, named DJs, music that reads the room. No upcharges, ever."
  transparentNav
>
  <!-- Hero with real photo -->
  <section class="relative py-40 md:py-52 lg:py-64 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt="Wedding reception at sunset on Whidbey Island"
        class="w-full h-full object-cover"
        widths={[640, 1024, 1536, 2048]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-deep-sound-950/60" />
    </div>
    <div class="relative max-w-4xl mx-auto px-6">
      <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-8">
        {entry?.data.heroHeading ?? "Your wedding, your music."}
      </h1>
      <p class="font-editorial text-lg text-driftwood-200/90 leading-relaxed max-w-xl mb-12">
        {entry?.data.heroSubheading}
      </p>
      <Button href="/contact" variant="primary" size="lg">
        Check your date
      </Button>
    </div>
  </section>

  <!-- Body content — split layout with real photo -->
  {Content && (
    <SplitSection>
      <div data-reveal>
        <div class="prose prose-lg max-w-none font-body text-deep-sound-700 leading-relaxed space-y-6
          [&>p]:text-body [&>p]:leading-relaxed">
          <Content />
        </div>
      </div>
      <div class="relative rounded-lg overflow-hidden aspect-[4/3]" data-reveal>
        <Image
          src={splitImage}
          alt="DJ turntable overlooking outdoor wedding dance floor"
          class="w-full h-full object-cover"
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </SplitSection>
  )}

  <!-- Full-bleed photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <Image
      src={sectionBreakImage}
      alt="Elegant long table setup under trees"
      class="w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
  </div>

  <!-- What's included -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
    <div class="max-w-4xl mx-auto px-6" data-reveal>
      <SectionHeading
        eyebrow="What's Included"
        heading="Everything you need. Nothing you don't."
      />
      <ul class="mt-12 space-y-4 max-w-lg">
        {[
          "Professional sound system",
          "DJ & MC services",
          "Dance floor lighting & uplights",
          "Planning meetings (as many as you need)",
          "Setup & teardown included",
          "$0 upcharges — always",
        ].map((item) => (
          <li class="flex items-start gap-4">
            <span class="text-golden-hour text-lg mt-0.5 shrink-0" aria-hidden="true">&check;</span>
            <span class="font-body text-body text-driftwood-200">{item}</span>
          </li>
        ))}
      </ul>
      <div class="mt-14">
        <Button href="/pricing" variant="secondary" size="md">
          See pricing
        </Button>
      </div>
    </div>
  </section>

  <!-- Wedding reviews — featured single + supporting -->
  {weddingReviews.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="From Our Couples"
          heading="What they said after the last song."
        />
        <!-- Featured first review, large -->
        {(() => {
          const first = weddingReviews[0];
          return (
            <div class="mt-14 mb-12">
              <div class="bg-deep-sound rounded-xl p-10 md:p-14">
                <ReviewCard
                  attribution={first.entry.data.attribution}
                  eventType={first.entry.data.eventType}
                >
                  <first.Content />
                </ReviewCard>
              </div>
            </div>
          );
        })()}
        {weddingReviews.length > 1 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {weddingReviews.slice(1).map(({ entry, Content }) => (
              <div class="bg-deep-sound-900 rounded-xl p-8">
                <ReviewCard
                  attribution={entry.data.attribution}
                  eventType={entry.data.eventType}
                >
                  <Content />
                </ReviewCard>
              </div>
            ))}
          </div>
        )}
        <div class="text-center mt-12">
          <Button href="/reviews" variant="outline" size="md">
            All reviews
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-950">
    <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
      <h2 class="font-heading text-3xl md:text-section text-driftwood leading-tight mb-6">
        Let&rsquo;s talk about your wedding.
      </h2>
      <p class="font-editorial text-body text-sea-glass-300 mb-12 italic">
        No commitment, no sales pitch. Tell us your date and we&rsquo;ll
        take it from there.
      </p>
      <Button href="/contact" variant="primary" size="lg">
        Check availability
      </Button>
    </div>
  </section>
</BaseLayout>
