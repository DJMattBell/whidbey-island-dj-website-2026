---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/Button.astro";
import { sourceLabels } from "../lib/labels";
import waveVinyl from "../assets/wave-vinyl-placeholder.svg";
import heroImage from "../assets/photos/party-moment.jpg";

// Homepage photo grid — outcome shots only (people, energy, moments)
import gridFirstDance from "../assets/gallery/first-dance.jpeg";
import gridLift from "../assets/gallery/groom-lifts-guest.jpeg";
import gridPurple from "../assets/gallery/purple-dance-floor.jpeg";
import gridChandelier from "../assets/gallery/chandelier-dancing.jpeg";
import gridGlow from "../assets/gallery/glow-sticks-dance.jpeg";
import gridLodge from "../assets/gallery/blue-lit-lodge.jpg";
import gridBooth from "../assets/gallery/photobooth-confetti.jpeg";
import gridDock from "../assets/gallery/dock-blue-uplighting.jpeg";
import gridTent from "../assets/gallery/sailcloth-tent-twilight.jpeg";

const gridPhotos = [
  { src: gridFirstDance, alt: "A couple shares their first dance beneath a hanging floral chandelier" },
  { src: gridLift, alt: "A guest lifts someone while dancing at a barn reception with colorful LED lighting" },
  { src: gridPurple, alt: "A packed wedding dance floor washed in purple and blue uplighting" },
  { src: gridChandelier, alt: "A guest dances with arms raised beneath a crystal chandelier" },
  { src: gridGlow, alt: "Wedding guests wave LED glow sticks on the dance floor with the bride at center" },
  { src: gridLodge, alt: "Wedding guests on the dance floor of a rustic lodge bathed in blue uplighting" },
  { src: gridBooth, alt: "Wedding guests throwing confetti in the photo booth" },
  { src: gridDock, alt: "A couple embraces on a wooden dock under blue uplighting with string lights behind" },
  { src: gridTent, alt: "A sailcloth tent glows with warm amber lighting at dusk among Pacific Northwest evergreens" },
];

const siteEntry = await getEntry("site", "site");
const site = siteEntry?.data;

const allReviews = await getCollection("reviews");
// Landing shows one review — prefer shortest featured review to fit the fixed screen
const featuredEntries = allReviews
  .filter((r) => r.data.featured)
  .sort((a, b) => (a.body?.length ?? 0) - (b.body?.length ?? 0));
const featuredEntry = featuredEntries[0];
const featured = featuredEntry
  ? { entry: featuredEntry, Content: (await render(featuredEntry)).Content }
  : null;

// Social proof — 3 short reviews from external sources for below-fold section
const socialProofReviews = await Promise.all(
  allReviews
    .filter((r) => r.data.source !== "direct" && (r.body?.length ?? 0) > 80)
    .sort((a, b) => (a.body?.length ?? 0) - (b.body?.length ?? 0))
    .slice(0, 3)
    .map(async (review) => {
      const { Content } = await render(review);
      return { entry: review, Content };
    }),
);

// Review stats — honest count, real platforms
const externalSources = [
  ...new Set(
    allReviews
      .filter((r) => r.data.source !== "direct")
      .map((r) => sourceLabels[r.data.source as keyof typeof sourceLabels] ?? r.data.source),
  ),
];
const reviewCount = allReviews.length;

const description =
  "The Whidbey Island DJ Collective — weddings, school dances, and community events across the Puget Sound. Transparent pricing, named DJs, music that reads the room.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site?.businessName ?? "Whidbey Island DJ Collective",
  description,
  url: "https://whidbeyislanddj.com",
  email: site?.email,
  areaServed: site?.serviceArea,
};
---

<BaseLayout
  title={`The ${site?.businessName ?? "Whidbey Island DJ Collective"} — Music That Reads the Room`}
  description={description}
  jsonLd={jsonLd}
  landing
>
  <!-- Full-bleed hero -->
  <div class="relative min-h-dvh flex flex-col">
    <!-- Background photo with overlay -->
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt=""
        class="w-full h-full object-cover"
        widths={[640, 1024, 1536, 2048]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-deep-sound-950/85" />
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center justify-center flex-1 px-5 pt-10 pb-6 sm:px-8 sm:pt-14 sm:pb-8">

      <!-- Mark -->
      <div data-reveal-slow="fade" data-reveal-delay="100" class="mb-6 sm:mb-8">
        <img
          src={waveVinyl.src}
          width="400"
          height="400"
          alt="Whidbey Island DJ Collective — vinyl record with rolling wave grooves and island coastline"
          class="w-28 h-28 sm:w-36 sm:h-36 md:w-44 md:h-44"
        />
      </div>

      <!-- Headline — "Your DJ from Day One" differentiator -->
      <h1 data-reveal-slow data-reveal-delay="250" class="font-heading text-2xl sm:text-3xl md:text-4xl text-driftwood text-center leading-snug max-w-2xl mb-4 sm:mb-5">
        Your DJ from day one — keeping your guests dancing from the first song to the last.
      </h1>

      <!-- Subhead -->
      <p data-reveal-slow="fade" data-reveal-delay="400" class="font-body text-sm sm:text-base text-driftwood-200 text-center max-w-lg mb-6 sm:mb-8 leading-relaxed">
        Weddings, school dances, and community events across Whidbey Island and the Puget Sound.
      </p>

      <!-- Primary CTA -->
      <a
        data-reveal-slow data-reveal-delay="550"
        href="/contact"
        class="inline-flex items-center justify-center px-6 py-3 sm:px-8 sm:py-3.5 font-body text-sm sm:text-base font-semibold tracking-wide text-deep-sound-950 bg-golden-hour hover:bg-golden-hour-400 rounded-lg transition-colors duration-200 mb-6 sm:mb-8 min-h-[44px]"
      >
        Check availability for your date
      </a>

      <!-- Decorative divider -->
      <div data-reveal-slow="fade" data-reveal-delay="650" class="w-16 h-px bg-driftwood-300/30 mb-4 sm:mb-5"></div>

      <!-- Outcome line above the doors -->
      <p data-reveal-slow="fade" data-reveal-delay="700" class="font-editorial text-sm sm:text-base text-driftwood-200/80 text-center italic mb-5 sm:mb-6">
        Your guests leave talking about the music.
      </p>

      <!-- Secondary navigation -->
      <nav class="flex items-center gap-8 sm:gap-12 mb-8 sm:mb-10" aria-label="Services">
        <a data-reveal-slow="left" data-reveal-delay="750" href="/weddings" class="font-heading text-lg sm:text-xl text-driftwood hover:text-golden-hour transition-colors duration-300 px-2 py-1">
          See weddings
        </a>
        <a data-reveal-slow="right" data-reveal-delay="750" href="/events" class="font-heading text-lg sm:text-xl text-driftwood hover:text-golden-hour transition-colors duration-300 px-2 py-1">
          See other events
        </a>
      </nav>

      <!-- Featured review -->
      {featured && (
        <blockquote data-reveal-slow="fade" data-reveal-delay="900" class="max-w-[340px] sm:max-w-md text-center rounded-lg px-5 py-4 bg-deep-sound-950/40 backdrop-blur-sm border border-driftwood-300/10">
          <div class="font-editorial text-[13px] sm:text-sm text-driftwood-200 italic leading-relaxed line-clamp-3 sm:line-clamp-none [&>p]:m-0">
            <featured.Content />
          </div>
          <footer class="font-body text-[10px] sm:text-xs text-golden-hour mt-3 tracking-[0.2em] uppercase">
            &mdash; {featured.entry.data.attribution}
          </footer>
        </blockquote>
      )}

    </div>
  </div>

  <!-- Photo grid — outcome shots, not gear -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-6xl mx-auto px-6">
      <SectionHeading
        eyebrow="Real Events"
        heading="This is what it looks like."
        dark={false}
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-12">
        {gridPhotos.map((photo) => (
          <div class="overflow-hidden rounded-lg" data-reveal>
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="w-full h-auto object-cover hover:scale-105 transition-transform duration-400 ease-out"
            />
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <Button href="/gallery" variant="outline" size="md">
          View the full gallery
        </Button>
      </div>
    </div>
  </section>

  <!-- Social proof — real reviews with source attribution -->
  {socialProofReviews.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
      <div class="max-w-4xl mx-auto px-6">
        <SectionHeading
          eyebrow="Reviews"
          heading="What they said after the last song."
        />
        <p class="font-body text-sm text-driftwood-400 mt-4">
          {reviewCount} five-star reviews on {externalSources.join(", ").replace(/, ([^,]*)$/, ", and $1")}
        </p>
        <div class="mt-12 space-y-8 max-w-2xl" data-reveal>
          {socialProofReviews.map(({ entry, Content }) => (
            <blockquote class="font-editorial text-body text-driftwood-200 italic leading-relaxed">
              <div class="[&>p]:m-0 line-clamp-4">
                <Content />
              </div>
              <footer class="font-body text-sm mt-3 not-italic flex flex-wrap items-center gap-x-2">
                <span class="text-golden-hour font-semibold tracking-wide uppercase">
                  &mdash; {entry.data.attribution}
                </span>
                {entry.data.source !== "direct" && (
                  <span class="text-driftwood-400">
                    via {sourceLabels[entry.data.source as keyof typeof sourceLabels] ?? entry.data.source}
                  </span>
                )}
              </footer>
            </blockquote>
          ))}
        </div>
        <div class="mt-10">
          <Button href="/reviews" variant="outline" size="md">
            Read all reviews
          </Button>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
