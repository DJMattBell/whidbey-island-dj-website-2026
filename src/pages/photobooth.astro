---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import CtaSection from "../components/CtaSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import { formatPrice } from "../lib/format";
import heroImage from "../assets/photos/matt-glow-stick.jpg";
import splitImage from "../assets/photos/dj-action-2.jpg";

const photoboothAddons = (await getCollection("addons"))
  .filter((a) => a.data.category === "photobooth")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  title="Photobooth | Whidbey Island DJ Collective"
  description="Open-air photobooth for weddings and events on Whidbey Island. Prints, digital copies, backdrops, and props included."
  transparentNav
>
  <PhotoHero image={heroImage} alt="DJ celebrating with glow sticks at an event" imageClass="object-top">
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-8">
      The booth that never stops.
    </h1>
    <p class="font-editorial text-lg text-driftwood-200/90 leading-relaxed max-w-xl italic">
      An open-air photobooth your guests will actually use — lowered to
      accessible height, stocked with props, and running all night.
    </p>
  </PhotoHero>

  <!-- What's included — split layout with real photo -->
  <SplitSection>
    <div data-reveal>
      <SectionHeading
        eyebrow="What's Included"
        heading="Everything in the booth."
      />
      <ul class="space-y-4 mt-8">
        {[
          "Open-air booth setup (lowered to accessible height)",
          "Backdrop and dress-up props",
          "Digital copies delivered to every guest",
          "Unlimited sessions during your event",
        ].map((item) => (
          <li class="flex items-start gap-4">
            <span class="text-golden-hour text-lg mt-0.5 shrink-0" aria-hidden="true">&check;</span>
            <span class="font-body text-body text-deep-sound-700">{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="relative rounded-lg overflow-hidden aspect-[4/3]" data-reveal>
      <Image
        src={splitImage}
        alt="Guests dancing with glow sticks at a reception"
        class="w-full h-full object-cover"
        widths={[400, 800]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    </div>
  </SplitSection>

  <!-- Print formats + Backdrops -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
    <div class="max-w-4xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12" data-reveal>
        <!-- Print formats -->
        <div>
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
            Print Formats
          </p>
          <h3 class="font-heading text-2xl md:text-3xl text-driftwood leading-tight mb-6">
            Take it home.
          </h3>
          <div class="space-y-6">
            <div>
              <p class="font-heading text-3xl text-driftwood mb-1">4&times;6</p>
              <p class="font-body text-sm text-driftwood-300">
                Classic photo print — perfect for fridge magnets and frames.
              </p>
            </div>
            <div>
              <p class="font-heading text-3xl text-driftwood mb-1">2&times;6 strip</p>
              <p class="font-body text-sm text-driftwood-300">
                Photo strip — the one your guests will keep in their wallet.
              </p>
            </div>
          </div>
        </div>

        <!-- Backdrops -->
        <div>
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
            Backdrops
          </p>
          <h3 class="font-heading text-2xl md:text-3xl text-driftwood leading-tight mb-6">
            Pick your look.
          </h3>
          <p class="font-body text-body text-driftwood-300 leading-relaxed">
            We bring a selection of backdrops to match your event&rsquo;s vibe
            &mdash; from classic solid colors to seasonal options. Need something
            custom? Let us know and we&rsquo;ll see what we can do.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  {photoboothAddons.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="Pricing"
          heading="Add it to any package."
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12">
          {photoboothAddons.map((addon) => (
            <div class="bg-driftwood rounded-lg p-6 border border-penn-cove-200">
              <div class="flex justify-between items-start gap-4 mb-2">
                <h3 class="font-heading text-xl text-penn-cove">
                  {addon.data.name}
                </h3>
                <span class="font-heading text-xl text-deep-sound whitespace-nowrap">
                  {formatPrice(addon.data.priceCents)}
                </span>
              </div>
              <p class="font-body text-sm text-deep-sound-700 leading-relaxed">
                {addon.data.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection
    heading="Add a photobooth to your event."
    body="It&rsquo;s the easiest upgrade you&rsquo;ll make. Tell us your date and we&rsquo;ll add it to your package."
    buttonText="Get in touch"
  />
</BaseLayout>
