---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextHero from "../components/TextHero.astro";
import CtaSection from "../components/CtaSection.astro";
import { faqCategoryLabels, faqCategoryOrder } from "../lib/labels";

const siteEntry = await getEntry("site", "site");
const responseHours = siteEntry?.data.responsePromiseHours ?? 24;

const allFaq = (await getCollection("faq"))
  .filter((f) => f.data.published)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const grouped = faqCategoryOrder
  .map((cat) => ({
    category: cat,
    label: faqCategoryLabels[cat],
    items: allFaq.filter((f) => f.data.category === cat),
  }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  title="FAQ | Whidbey Island DJ Collective"
  description="Frequently asked questions about hiring a DJ on Whidbey Island. Pricing, music selection, what's included, and more."
>
  <TextHero>
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-6">
      Questions we hear a lot.
    </h1>
    <p class="font-editorial text-lg text-sea-glass-300 leading-relaxed max-w-xl italic">
      If yours isn&rsquo;t here, ask us directly &mdash; we&rsquo;ll get back to
      you within {responseHours} hours.
    </p>
  </TextHero>

  <!-- FAQ accordion grouped by category -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-3xl mx-auto px-6">
      {grouped.map((group) => (
        <div class="mb-12 last:mb-0" data-reveal>
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour-700 mb-4">
            {group.label}
          </p>
          <div class="space-y-3">
            {group.items.map((faq) => (
              <details class="group rounded-lg border border-penn-cove-200 bg-driftwood">
                <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-4 font-heading text-lg text-penn-cove select-none">
                  <span>{faq.data.question}</span>
                  <span
                    class="shrink-0 text-penn-cove transition-transform duration-200 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <div class="px-6 pb-6 font-body text-body text-deep-sound-700 leading-relaxed">
                  {faq.body}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaSection
    heading="Still have questions?"
    body="We&rsquo;re happy to chat. No pressure, no pitch."
    buttonText="Ask us anything"
  />
</BaseLayout>
