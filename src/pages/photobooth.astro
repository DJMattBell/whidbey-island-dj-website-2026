---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import CtaSection from "../components/CtaSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import Button from "../components/Button.astro";
import { formatPrice } from "../lib/format";
import heroImage from "../assets/gallery/photobooth-kiosk-barn.jpeg";
import splitImage from "../assets/gallery/photobooth-confetti.jpeg";

const photoboothAddons = (await getCollection("addons"))
  .filter((a) => a.data.category === "photobooth")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const printAddon = photoboothAddons.find((a) => a.data.standalonePriceCents);
const digitalAddon = photoboothAddons.find(
  (a) => a.id === "photobooth-digital",
);
const extraHour = photoboothAddons.find(
  (a) => a.id === "photobooth-extra-hour",
);
const customBackdrop = photoboothAddons.find(
  (a) => a.id === "photobooth-custom-backdrop",
);

const printFeatures = printAddon?.data.features ?? [];

const equipment = (await getCollection("equipment"))
  .filter((e) => e.data.category === "photobooth")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const equipmentWithContent = await Promise.all(
  equipment.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const faqEntries = (await getCollection("faq"))
  .filter((f) => f.data.category === "photobooth" && f.data.published)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const faqWithContent = await Promise.all(
  faqEntries.map(async (faq) => {
    const { Content } = await render(faq);
    return { faq, Content };
  }),
);
---

<BaseLayout
  title="Photobooth | Whidbey Island DJ Collective"
  description="Open-air photobooth for weddings and events on Whidbey Island. Book standalone or bundle with a DJ package. Prints, digital copies, backdrops, and props included."
  transparentNav
>
  <PhotoHero
    image={heroImage}
    alt="Ring-light photo booth kiosk in a string-light-draped barn venue"
  >
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-8">
      The booth that never stops.
    </h1>
    <p class="font-editorial text-lg text-driftwood-200/90 leading-relaxed max-w-xl italic">
      An open-air photobooth your guests will actually use &mdash; prints in
      their hands, digital copies on their phones, and a prop tree that turns
      anyone into a character.
    </p>
  </PhotoHero>

  <!-- What's included — reads from addon features -->
  {printFeatures.length > 0 && (
    <SplitSection>
      <div data-reveal>
        <SectionHeading
          eyebrow="What's Included"
          heading="Everything in the booth."
          dark={false}
        />
        <ul class="space-y-4 mt-8">
          {printFeatures.map((item) => (
            <li class="flex items-start gap-4">
              <span
                class="text-golden-hour text-lg mt-0.5 shrink-0"
                aria-hidden="true"
              >
                &check;
              </span>
              <span class="font-body text-body text-deep-sound-700">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative rounded-lg overflow-hidden aspect-[4/3]" data-reveal>
        <Image
          src={splitImage}
          alt="Wedding guests making silly faces and throwing confetti in the photo booth"
          class="w-full h-full object-cover"
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </SplitSection>
  )}

  <!-- Print formats + Backdrops -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
    <div class="max-w-4xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12" data-reveal>
        <!-- Print formats -->
        <div>
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
            Print Formats
          </p>
          <h3 class="font-heading text-2xl md:text-3xl text-driftwood leading-tight mb-6">
            Take it home.
          </h3>
          <div class="space-y-6">
            <div>
              <p class="font-heading text-3xl text-driftwood mb-1">4&times;6</p>
              <p class="font-body text-sm text-driftwood-300">
                Classic photo print &mdash; one for your guest, one for the
                guest book.
              </p>
            </div>
            <div>
              <p class="font-heading text-3xl text-driftwood mb-1">
                2&times;6 strip
              </p>
              <p class="font-body text-sm text-driftwood-300">
                Photo strip &mdash; the one your guests will keep in their wallet.
              </p>
            </div>
          </div>
          <p class="font-body text-xs text-driftwood-300/70 mt-6">
            Printed on a DNP DS-620A &mdash; the industry standard for photo
            booth events.
          </p>
        </div>

        <!-- Backdrops -->
        <div>
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
            Backdrops
          </p>
          <h3 class="font-heading text-2xl md:text-3xl text-driftwood leading-tight mb-6">
            Pick your look.
          </h3>
          <ul class="space-y-3 mb-6">
            {["Light Marble", "Dark Marble", "White", "Green Screen"].map(
              (backdrop) => (
                <li class="flex items-start gap-3">
                  <span
                    class="text-golden-hour text-sm mt-1 shrink-0"
                    aria-hidden="true"
                  >
                    &check;
                  </span>
                  <span class="font-body text-sm text-driftwood-200">
                    {backdrop}
                  </span>
                </li>
              ),
            )}
          </ul>
          <p class="font-body text-sm text-driftwood-300 leading-relaxed">
            Need something custom? We offer custom backdrops{" "}
            {customBackdrop
              ? `starting from ${formatPrice(customBackdrop.data.priceCents)}`
              : "for an additional fee"}
            {" "}&mdash; match your colors, your theme, or your brand.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment spotlight (conditional — renders when entries exist) -->
  {equipmentWithContent.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="The Gear"
          heading="What we bring."
          dark={false}
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mt-12">
          {equipmentWithContent.map(({ entry, Content }) => (
            <div class="bg-driftwood rounded-lg border border-penn-cove-200 overflow-hidden">
              {entry.data.photo && (
                <Image
                  src={entry.data.photo}
                  alt={entry.data.name}
                  class="w-full aspect-[3/2] object-cover"
                  widths={[400, 600]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                />
              )}
              <div class="p-6">
                <h3 class="font-heading text-xl text-penn-cove mb-2">
                  {entry.data.name}
                </h3>
                <p class="font-body text-sm text-deep-sound-700 leading-relaxed">
                  {entry.data.whatItDoes}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Standalone pricing -->
  {printAddon && (
    <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading eyebrow="Pricing" heading="Book the booth." />

        <!-- Standalone card -->
        <div class="bg-driftwood/10 rounded-lg p-8 border border-driftwood-300/10 mt-12">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
            <h3 class="font-heading text-2xl text-driftwood">
              {printAddon.data.name}
            </h3>
            <span class="font-heading text-3xl text-golden-hour whitespace-nowrap">
              {formatPrice(printAddon.data.standalonePriceCents!)}
            </span>
          </div>
          <p class="font-body text-sm text-driftwood-300 leading-relaxed mb-6">
            {printAddon.data.description}
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="/contact" variant="primary" size="md">
              Book the booth
            </Button>
          </div>
        </div>

        <!-- Bundle callout -->
        <div class="mt-8 rounded-lg p-8 border border-golden-hour/30 bg-golden-hour/5">
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
            DJ Bundle
          </p>
          <h3 class="font-heading text-2xl text-driftwood leading-tight mb-4">
            Already booking a DJ?{" "}
            {printAddon.data.bundleDiscountCents
              ? `Save ${formatPrice(printAddon.data.bundleDiscountCents)}.`
              : "Save when you bundle."}
          </h3>
          <div class="space-y-4">
            <div class="flex justify-between items-start gap-4">
              <div>
                <p class="font-body text-sm text-driftwood-200 font-semibold">
                  Printing + Attendant
                </p>
                <p class="font-body text-xs text-driftwood-300">3 hours included</p>
              </div>
              <span class="font-heading text-xl text-golden-hour whitespace-nowrap">
                {formatPrice(printAddon.data.priceCents)}
              </span>
            </div>
            {digitalAddon && (
              <div class="flex justify-between items-start gap-4">
                <div>
                  <p class="font-body text-sm text-driftwood-200 font-semibold">
                    Digital Only
                  </p>
                  <p class="font-body text-xs text-driftwood-300">
                    3 hours, no printing &mdash; add-on only
                  </p>
                </div>
                <span class="font-heading text-xl text-golden-hour whitespace-nowrap">
                  {formatPrice(digitalAddon.data.priceCents)}
                </span>
              </div>
            )}
            {extraHour && (
              <div class="flex justify-between items-start gap-4 pt-2 border-t border-driftwood-300/10">
                <p class="font-body text-sm text-driftwood-300">
                  {extraHour.data.name}
                </p>
                <span class="font-heading text-lg text-driftwood-200 whitespace-nowrap">
                  {formatPrice(extraHour.data.priceCents)}
                </span>
              </div>
            )}
          </div>
          <div class="mt-6">
            <Button href="/contact" variant="secondary" size="md">
              Add to your DJ package
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Photobooth FAQ (conditional) -->
  {faqWithContent.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-3xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="FAQ"
          heading="Common questions."
          dark={false}
        />
        <div class="space-y-3 mt-12">
          {faqWithContent.map(({ faq, Content }) => (
            <details class="group rounded-lg border border-penn-cove-200 bg-driftwood">
              <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-4 font-heading text-lg text-penn-cove select-none">
                <span>{faq.data.question}</span>
                <span
                  class="shrink-0 text-penn-cove transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="px-6 pb-6 font-body text-body text-deep-sound-700 leading-relaxed">
                <Content />
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dual CTA -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-950">
    <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
      <h2 class="font-heading text-3xl md:text-section leading-tight text-driftwood mb-6">
        Ready to book the booth?
      </h2>
      <p class="font-editorial text-body text-sea-glass-300 italic mb-12">
        Tell us your date and we&rsquo;ll put together a quote &mdash; standalone
        or bundled with a DJ package.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contact" variant="primary" size="lg">
          Book the booth
        </Button>
        <Button href="/pricing" variant="outline" size="lg">
          See all pricing
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
