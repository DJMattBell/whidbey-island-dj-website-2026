---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextHero from "../components/TextHero.astro";
import CtaSection from "../components/CtaSection.astro";
import Button from "../components/Button.astro";
import { formatPrice } from "../lib/format";

const allTiers = (await getCollection("pricingTiers")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
// Show only the two real packages — the "Our Promise" card moves to inline copy
const packages = allTiers.filter((t) => t.data.priceCents > 0);

const allAddons = (await getCollection("addons")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

// Show top 2 DJ/ceremony add-ons here; the rest live on dedicated pages
const featuredAddons = allAddons
  .filter((a) => a.data.category !== "photobooth")
  .slice(0, 2);
---

<BaseLayout
  title="Pricing"
  description="Transparent DJ pricing for weddings and events on Whidbey Island. Packages from $1,900 to $2,100 — no upcharges, no surprises."
>
  <TextHero>
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-6">
      Wedding DJ Packages
    </h1>
    <p class="font-editorial text-lg text-sea-glass-300 leading-relaxed max-w-xl italic">
      Real numbers, live on this page — not locked behind a contact form. The
      price you see is the price you pay.
    </p>
  </TextHero>

  <!-- Packages — two-column comparison -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-4xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {packages.map((tier) => (
          <div
            class:list={[
              "rounded-lg p-8 flex flex-col",
              tier.data.highlight
                ? "bg-penn-cove text-driftwood ring-2 ring-penn-cove"
                : "bg-driftwood border border-penn-cove-200",
            ]}
            data-reveal
          >
            {tier.data.badge && (
              <span
                class:list={[
                  "self-start font-body text-xs font-semibold tracking-[0.15em] uppercase px-3 py-1 rounded-full mb-4",
                  tier.data.highlight
                    ? "bg-golden-hour text-deep-sound"
                    : "bg-penn-cove-100 text-penn-cove",
                ]}
              >
                {tier.data.badge}
              </span>
            )}
            <h2
              class:list={[
                "font-heading text-2xl leading-tight mb-2",
                tier.data.highlight ? "text-driftwood" : "text-penn-cove",
              ]}
            >
              {tier.data.name}
            </h2>
            <p
              class:list={[
                "font-heading text-4xl mb-4",
                tier.data.highlight ? "text-driftwood" : "text-deep-sound",
              ]}
            >
              {formatPrice(tier.data.priceCents)}
            </p>
            <p
              class:list={[
                "font-body text-sm leading-relaxed mb-6",
                tier.data.highlight
                  ? "text-driftwood-200"
                  : "text-deep-sound-700",
              ]}
            >
              {tier.data.description}
            </p>
            <ul class="space-y-3 mt-auto mb-8">
              {tier.data.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <span
                    class="mt-0.5 shrink-0 text-golden-hour"
                    aria-hidden="true"
                  >
                    &check;
                  </span>
                  <span
                    class:list={[
                      "font-body text-sm",
                      tier.data.highlight
                        ? "text-driftwood-200"
                        : "text-deep-sound-700",
                    ]}
                  >
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
            <Button
              href="/contact"
              variant={tier.data.highlight ? "secondary" : "outline"}
              size="md"
            >
              Check availability for your date
            </Button>
          </div>
        ))}
      </div>

      <!-- No-upcharges line + range summary (replaces the "Our Promise" card) -->
      <div class="mt-12 text-center space-y-4" data-reveal>
        <p class="font-body text-sm text-deep-sound-700 leading-relaxed">
          No upcharges. Extra uplights, microphones, and planning meetings are included.
        </p>
        <p class="font-body text-sm text-deep-sound-500 leading-relaxed">
          Our wedding DJ packages range from $1,900 to $2,100. Most Saturday weddings land at the top of that range.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured add-ons (top 2 only — keeps the page focused) -->
  {featuredAddons.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <h2 class="font-heading text-3xl md:text-section leading-tight text-driftwood mb-4">
          Popular add-ons
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12">
          {featuredAddons.map((addon) => (
            <div class="bg-driftwood/10 rounded-lg p-6 border border-driftwood-300/10">
              <div class="flex justify-between items-start gap-4 mb-2">
                <h3 class="font-heading text-xl text-driftwood">
                  {addon.data.name}
                </h3>
                <span class="font-heading text-xl text-golden-hour whitespace-nowrap">
                  {formatPrice(addon.data.priceCents)}
                </span>
              </div>
              <p class="font-body text-sm text-driftwood-300 leading-relaxed">
                {addon.data.description}
              </p>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <Button href="/add-ons" variant="secondary" size="md">
            See all add-ons
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- Photobooth callout — links to dedicated page instead of listing all options -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
      <h2 class="font-heading text-3xl md:text-section leading-tight text-penn-cove mb-4">
        Add a photobooth
      </h2>
      <p class="font-editorial text-body text-deep-sound-700 italic mb-8">
        Standalone from $1,200, or $1,000 when bundled with a DJ package. On-site printing, digital delivery, and a prop tree your guests will love.
      </p>
      <Button href="/photobooth" variant="outline" size="md">
        See photobooth options
      </Button>
    </div>
  </section>

  <CtaSection
    heading="Ready to book?"
    body="Tell us your date and event type. We&rsquo;ll send you a straightforward quote &mdash; no follow-up calls unless you want them."
    buttonText="Check availability for your date"
  />
</BaseLayout>
