---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import CtaSection from "../components/CtaSection.astro";
import FeaturedReviewSection from "../components/FeaturedReviewSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import Button from "../components/Button.astro";
import heroImage from "../assets/photos/dj-action-1.jpg";
import splitImage from "../assets/photos/dj-action-2.jpg";
import sectionBreakImage from "../assets/photos/lakeside-ceremony.jpg";

const entry = await getEntry("services", "events");
const { Content } = entry ? await render(entry) : { Content: null };

const eventReviews = await Promise.all(
  (await getCollection("reviews"))
    .filter((r) => r.data.eventType !== "wedding")
    .slice(0, 3)
    .map(async (review) => {
      const { Content } = await render(review);
      return { entry: review, Content };
    }),
);
---

<BaseLayout
  title="Not Weddings | Whidbey Island DJ Collective"
  description="DJ services for school dances, auctions, community events, and private parties on Whidbey Island and the Puget Sound. Clean lyrics, flat pricing, COI available."
  transparentNav
>
  <PhotoHero image={heroImage} alt="Overhead view of DJ booth and packed dance floor with string lights">
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-8">
      {entry?.data.heroHeading ?? "Events that run like clockwork."}
    </h1>
    <p class="font-editorial text-lg text-driftwood-200/90 leading-relaxed max-w-xl mb-12">
      {entry?.data.heroSubheading}
    </p>
    <Button href="/contact" variant="primary" size="lg">
      Check your date
    </Button>
  </PhotoHero>

  <!-- Body content — split layout with real photo -->
  {Content && (
    <SplitSection reverse>
      <div data-reveal>
        <div class="prose prose-lg max-w-none font-body text-deep-sound-700 leading-relaxed space-y-6
          [&>p]:text-body [&>p]:leading-relaxed">
          <Content />
        </div>
      </div>
      <div class="relative rounded-lg overflow-hidden aspect-[4/3]" data-reveal>
        <Image
          src={splitImage}
          alt="Guests waving glow sticks on the dance floor"
          class="w-full h-full object-cover"
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </SplitSection>
  )}

  <!-- What organizers need to know -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
    <div class="max-w-4xl mx-auto px-6" data-reveal>
      <SectionHeading
        eyebrow="For Organizers"
        heading="What you need to know."
      />
      <ul class="mt-12 space-y-4 max-w-lg">
        {[
          "Clean lyrics guaranteed — always",
          "Certificate of insurance (COI) on request",
          "Flat pricing — no upcharges, ever",
          "PO-friendly invoicing",
          "Experience with student councils & auction committees",
          "Full sound, lighting, and MC services included",
        ].map((item) => (
          <li class="flex items-start gap-4">
            <span class="text-golden-hour text-lg mt-0.5 shrink-0" aria-hidden="true">&check;</span>
            <span class="font-body text-body text-driftwood-200">{item}</span>
          </li>
        ))}
      </ul>
      <div class="mt-14">
        <Button href="/pricing" variant="secondary" size="md">
          See pricing
        </Button>
      </div>
    </div>
  </section>

  <!-- Full-bleed photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <Image
      src={sectionBreakImage}
      alt="Ceremony setup by the lake with DJ equipment in the foreground"
      class="w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
  </div>

  <!-- School dances & community events -->
  <SplitSection>
    <div data-reveal>
      <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
        School Dances
      </p>
      <h3 class="font-heading text-2xl md:text-3xl text-penn-cove leading-tight mb-4">
        Homecoming to prom and everything between.
      </h3>
      <p class="font-body text-body text-deep-sound-700 leading-relaxed">
        We work directly with student councils and advisors. Clean lyrics
        are non-negotiable, the music stays age-appropriate, and we bring
        enough sound and lighting to fill any gym or cafeteria.
      </p>
    </div>
    <div data-reveal>
      <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-3">
        Auctions &amp; Community Events
      </p>
      <h3 class="font-heading text-2xl md:text-3xl text-penn-cove leading-tight mb-4">
        Sound that works for the room.
      </h3>
      <p class="font-body text-body text-deep-sound-700 leading-relaxed">
        Fundraiser auctions, galas, community festivals, private parties
        &mdash; we bring the right energy for your audience. Professional
        MC services, wireless mics, and a crew that shows up early.
      </p>
    </div>
  </SplitSection>

  <FeaturedReviewSection
    eyebrow="From Event Organizers"
    heading="What they said after the event."
    reviews={eventReviews}
    dark
  />

  <CtaSection
    heading="Let&rsquo;s talk about your event."
    body="Tell us what you&rsquo;re planning and we&rsquo;ll put together a quote. No commitment, no hassle."
    buttonText="Get in touch"
    dark={false}
  />
</BaseLayout>
