---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import CtaSection from "../components/CtaSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SplitSection from "../components/SplitSection.astro";
import Button from "../components/Button.astro";
import heroImage from "../assets/photos/reception-scene.jpg";
import splitImage from "../assets/photos/event-scene-2.jpg";
import sectionBreakImage from "../assets/photos/elegant-table-setup.jpg";

const entry = await getEntry("services", "weddings");
const { Content } = entry ? await render(entry) : { Content: null };
---

<BaseLayout
  title="Weddings"
  description="Wedding DJ services on Whidbey Island and the Puget Sound. Transparent pricing, named DJs, music that keeps your guests dancing. No upcharges, ever."
  transparentNav
>
  <PhotoHero
    image={heroImage}
    alt="Wedding reception at sunset on Whidbey Island"
  >
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-8">
      {entry?.data.heroHeading ?? "Your wedding, your music."}
    </h1>
    <p class="font-editorial text-lg text-driftwood-200/90 leading-relaxed max-w-xl mb-12">
      {entry?.data.heroSubheading}
    </p>
    <Button href="/contact" variant="primary" size="lg">
      Check your date
    </Button>
  </PhotoHero>

  <!-- Body content — split layout with real photo -->
  {Content && (
    <SplitSection>
      <div data-reveal>
        <div
          class="prose prose-lg max-w-none font-body text-deep-sound-700 leading-relaxed space-y-6
          [&>p]:text-body [&>p]:leading-relaxed"
        >
          <Content />
        </div>
      </div>
      <div class="relative rounded-lg overflow-hidden aspect-[4/3]" data-reveal>
        <Image
          src={splitImage}
          alt="DJ turntable overlooking outdoor wedding dance floor"
          class="w-full h-full object-cover"
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      </div>
    </SplitSection>
  )}

  <!-- Full-bleed photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <Image
      src={sectionBreakImage}
      alt="Elegant long table setup under trees"
      class="w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
  </div>

  <!-- What's included — plain text, no checkmark bullets -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
    <div class="max-w-4xl mx-auto px-6" data-reveal>
      <SectionHeading
        eyebrow="What's Included"
        heading="Everything you need. Nothing you don't."
      />
      <div class="mt-12 max-w-lg space-y-3">
        {[
          "Professional sound system",
          "DJ & MC services",
          "Dance floor lighting & uplights",
          "Planning meetings — as many as you need",
          "6 hours of service",
          "Setup & teardown",
        ].map((item) => (
          <p class="font-body text-body text-driftwood-200">{item}</p>
        ))}
        <p class="font-body text-sm text-driftwood-300 mt-6">
          No upcharges. Extra uplights, microphones, and planning meetings are included.
        </p>
      </div>
      <div class="mt-14">
        <Button href="/pricing" variant="secondary" size="md">
          See pricing
        </Button>
      </div>
    </div>
  </section>

  <!-- Social proof — one-liners pulled from full reviews -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-4xl mx-auto px-6" data-reveal>
      <SectionHeading
        eyebrow="From Our Couples"
        heading="What they said after the last song."
        dark={false}
      />
      <div class="mt-12 space-y-8 max-w-2xl">
        <blockquote class="font-editorial text-body text-deep-sound-700 italic leading-relaxed">
          &ldquo;The dance floor was always packed from the moment we opened up the floor.&rdquo;
          <footer class="font-body text-sm text-deep-sound-500 mt-2 not-italic">
            &mdash; Anastasia W., wedding
          </footer>
        </blockquote>
        <blockquote class="font-editorial text-body text-deep-sound-700 italic leading-relaxed">
          &ldquo;All of our guests commented on how much fun they had on the dance floor!&rdquo;
          <footer class="font-body text-sm text-deep-sound-500 mt-2 not-italic">
            &mdash; Amber D., wedding
          </footer>
        </blockquote>
        <blockquote class="font-editorial text-body text-deep-sound-700 italic leading-relaxed">
          &ldquo;He was so flexible and adaptable, even smoothly navigating technical difficulties out of his control.&rdquo;
          <footer class="font-body text-sm text-deep-sound-500 mt-2 not-italic">
            &mdash; Andrew & E., wedding
          </footer>
        </blockquote>
      </div>
      <div class="mt-10">
        <Button href="/reviews" variant="outline" size="md">
          Read all reviews
        </Button>
      </div>
    </div>
  </section>

  <!-- Photobooth cross-link — specific pricing, corrected hours -->
  <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
    <div class="max-w-4xl mx-auto px-6" data-reveal>
      <SectionHeading
        eyebrow="Add a Photobooth"
        heading="Prints, props, and a lot of laughs."
      />
      <p class="font-body text-body text-driftwood-200 leading-relaxed mt-4 max-w-2xl">
        Our open-air booth runs for three hours with a dedicated attendant on
        site. Guests get prints in hand and digital copies on their phones
        &mdash; one strip for them, one for your guest book. Add it to your DJ
        package for $1,000 instead of $1,200 on its own.
      </p>
      <div class="mt-8">
        <Button href="/photobooth" variant="secondary" size="md">
          See photobooth packages
        </Button>
      </div>
    </div>
  </section>

  <!-- Quick links -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-4xl mx-auto px-6" data-reveal>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href="/add-ons" class="group rounded-lg p-8 border border-penn-cove-200 bg-driftwood hover:border-golden-hour transition-colors">
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-2">
            Add-ons
          </p>
          <h3 class="font-heading text-xl text-penn-cove mb-2">
            Customize your package.
          </h3>
          <p class="font-body text-sm text-deep-sound-700">
            Ceremony sound, activity boxes, photobooth, and more.
          </p>
        </a>
        <a href="/equipment" class="group rounded-lg p-8 border border-penn-cove-200 bg-driftwood hover:border-golden-hour transition-colors">
          <p class="font-body text-eyebrow font-semibold tracking-[0.3em] uppercase text-golden-hour mb-2">
            Equipment
          </p>
          <h3 class="font-heading text-xl text-penn-cove mb-2">
            See what we bring.
          </h3>
          <p class="font-body text-sm text-deep-sound-700">
            Our full lighting rig — uplights, effects, and everything in between.
          </p>
        </a>
      </div>
    </div>
  </section>

  <CtaSection
    heading="Let&rsquo;s talk about your wedding."
    body="Tell us your date and we&rsquo;ll send you availability and package options &mdash; no commitment, no sales pitch."
    buttonText="Check availability for your date"
  />
</BaseLayout>
