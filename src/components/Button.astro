---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className,
} = Astro.props;

const baseClasses =
  "inline-block font-body font-semibold tracking-wide rounded-md transition-colors duration-200 text-center";

const variantClasses = {
  primary: "bg-madrone text-driftwood hover:bg-madrone/85",
  secondary: "bg-sea-glass text-deep-sound hover:bg-sea-glass/85",
  outline:
    "border-2 border-penn-cove text-penn-cove hover:bg-penn-cove hover:text-driftwood",
};

const sizeClasses = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-body",
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(" ");

const Tag = href ? "a" : "button";
---

<Tag href={href} class={classes}>
  <slot />
</Tag>
