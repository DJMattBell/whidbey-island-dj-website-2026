---
import Button from "./Button.astro";
import PlaceholderArt from "./PlaceholderArt.astro";

interface Props {
  headline?: string;
  subheadline?: string;
  ctaText?: string;
  ctaHref?: string;
  backgroundVideo?: string;
}

const {
  headline = "Your event deserves music that reads the room.",
  subheadline = "We\u2019re a crew of DJs based on Whidbey Island. Weddings, school dances, and any event where the music matters more than the DJ\u2019s ego.",
  ctaText = "Check your date",
  ctaHref = "/contact",
  backgroundVideo,
} = Astro.props;
---

<section class="relative min-h-[90vh] md:min-h-[85vh] flex items-center bg-deep-sound overflow-hidden">
  {backgroundVideo ? (
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover motion-safe:block hidden"
    >
      <source src={backgroundVideo} type="video/mp4" />
    </video>
  ) : (
    <PlaceholderArt variant="warm" />
  )}

  <div class="absolute inset-0 bg-deep-sound/60" />

  <div class="relative max-w-4xl mx-auto px-6 text-center py-20">
    <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-hero text-driftwood leading-tight mb-6">
      {headline}
    </h1>
    <p class="font-body text-body text-sea-glass mb-10 max-w-2xl mx-auto leading-relaxed">
      {subheadline}
    </p>
    <Button href={ctaHref} variant="primary" size="lg">
      {ctaText}
    </Button>
  </div>
</section>
