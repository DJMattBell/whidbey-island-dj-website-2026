---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextHero from "../components/TextHero.astro";
import CtaSection from "../components/CtaSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/Button.astro";
import { formatPrice } from "../lib/format";

const allAddons = (await getCollection("addons")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const djAddons = allAddons.filter(
  (a) => a.data.category === "dj" || a.data.category === "ceremony",
);

const photoboothAddons = allAddons.filter(
  (a) => a.data.category === "photobooth",
);
---

<BaseLayout
  title="Add-Ons | Whidbey Island DJ Collective"
  description="DJ add-ons for weddings and events on Whidbey Island. Ceremony sound, live jazz piano, sensory experiences, and photobooth packages."
>
  <TextHero>
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-6">
      Add-ons
    </h1>
    <p class="font-editorial text-lg text-sea-glass-300 leading-relaxed max-w-xl italic">
      Everything here pairs with a DJ package. Pick what fits your
      event&nbsp;&mdash; skip what doesn&rsquo;t.
    </p>
  </TextHero>

  <!-- DJ & Ceremony add-ons -->
  {djAddons.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="DJ & Ceremony"
          heading="Make it yours."
          dark={false}
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12">
          {djAddons.map((addon) => (
            <div class="rounded-lg p-6 border border-penn-cove-200 bg-driftwood">
              <div class="flex justify-between items-start gap-4 mb-2">
                <h3 class="font-heading text-xl text-penn-cove">
                  {addon.data.name}
                </h3>
                <span class="font-heading text-xl text-deep-sound whitespace-nowrap">
                  {formatPrice(addon.data.priceCents)}
                </span>
              </div>
              <p class="font-body text-sm text-deep-sound-700 leading-relaxed">
                {addon.data.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Photobooth add-ons -->
  {photoboothAddons.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
      <div class="max-w-4xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="Photobooth"
          heading="Add a booth to your package."
        />
        <p class="font-body text-sm text-driftwood-300 mt-4 mb-12">
          Our photobooth runs standalone or as a DJ package add-on. Full
          details, backdrops, and print formats are on the{" "}
          <a href="/photobooth" class="text-golden-hour underline underline-offset-2 hover:text-golden-hour/80">
            photobooth page
          </a>.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {photoboothAddons.map((addon) => (
            <div class="bg-driftwood/10 rounded-lg p-6 border border-driftwood-300/10">
              <div class="flex justify-between items-start gap-4 mb-2">
                <h3 class="font-heading text-xl text-driftwood">
                  {addon.data.name}
                </h3>
                <span class="font-heading text-xl text-golden-hour whitespace-nowrap">
                  {formatPrice(addon.data.priceCents)}
                </span>
              </div>
              <p class="font-body text-sm text-driftwood-300 leading-relaxed">
                {addon.data.description}
              </p>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <Button href="/photobooth" variant="secondary" size="md">
            See photobooth details
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- Equipment callout -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
      <h2 class="font-heading text-3xl md:text-section leading-tight text-penn-cove mb-4">
        Want to see the gear?
      </h2>
      <p class="font-editorial text-body text-deep-sound-700 italic mb-8">
        Our full lighting and sound setup is documented on the equipment
        page&nbsp;&mdash; every fixture, every speaker, everything we bring.
      </p>
      <Button href="/equipment" variant="outline" size="md">
        See our equipment
      </Button>
    </div>
  </section>

  <CtaSection
    heading="Ready to customize your package?"
    body="Tell us your date and what you&rsquo;re thinking. We&rsquo;ll put together a quote with exactly the add-ons you want."
    buttonText="Check availability for your date"
  />
</BaseLayout>
