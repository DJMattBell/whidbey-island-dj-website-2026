---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import Button from "../../components/Button.astro";
import PlaceholderArt from "../../components/PlaceholderArt.astro";

export async function getStaticPaths() {
  const djs = await getCollection("djs");
  return djs.map((dj) => ({ params: { slug: dj.id }, props: { dj } }));
}

const { dj } = Astro.props;
const { Content } = await render(dj);

const allReviews = await getCollection("reviews");
const djReviews = await Promise.all(
  allReviews
    .filter((r) => r.data.dj === dj.id)
    .map(async (review) => {
      const { Content: ReviewContent } = await render(review);
      return { entry: review, ReviewContent };
    }),
);

const allDjs = (await getCollection("djs"))
  .filter((d) => d.id !== dj.id)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  title={`${dj.data.name} — ${dj.data.role} | Whidbey Island DJ Collective`}
  description={`${dj.data.name}, ${dj.data.role} at the Whidbey Island DJ Collective. ${dj.data.philosophy}`}
>
  <!-- Profile header -->
  <section class="py-24 md:py-32 lg:py-40 bg-deep-sound">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Photo -->
        <div class="relative rounded-lg overflow-hidden aspect-[4/5] bg-deep-sound" data-reveal>
          <PlaceholderArt variant="cool" />
          <div class="absolute inset-0 bg-deep-sound/20" />
        </div>

        <!-- Info -->
        <div data-reveal>
          <p class="font-body text-eyebrow font-semibold tracking-[0.2em] uppercase text-golden-hour mb-3">
            {dj.data.role}
          </p>
          <h1 class="font-heading text-5xl sm:text-6xl text-driftwood leading-tight mb-6">
            {dj.data.name}
          </h1>
          <p class="font-body text-body text-sea-glass-300 leading-relaxed mb-6 italic">
            &ldquo;{dj.data.philosophy}&rdquo;
          </p>
          <div class="flex flex-wrap gap-2 mb-8">
            {dj.data.specialties.map((s) => (
              <span class="font-body text-sm text-driftwood-200 bg-driftwood/10 px-3 py-1 rounded">
                {s}
              </span>
            ))}
          </div>
          <Button href="/contact" variant="primary" size="md">
            Book {dj.data.name.split(" ")[0]}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Bio -->
  <section class="py-20 md:py-28 lg:py-section">
    <div class="max-w-3xl mx-auto px-6" data-reveal>
      <div class="prose prose-lg max-w-none font-body text-deep-sound-700 leading-relaxed space-y-6
        [&>p]:text-body [&>p]:leading-relaxed">
        <Content />
      </div>
    </div>
  </section>

  <!-- Music favorites -->
  {dj.data.musicFavorites && (
    <section class="py-20 md:py-28 lg:py-section bg-deep-sound">
      <div class="max-w-3xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="Music Favorites"
          heading={`What ${dj.data.name.split(" ")[0]} plays.`}
          centered
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10">
          {[
            { label: "Go-to Anthem", value: dj.data.musicFavorites.goToAnthem },
            { label: "Guilty Pleasure", value: dj.data.musicFavorites.guiltyPleasure },
            { label: "For the Parents", value: dj.data.musicFavorites.forTheParents },
            { label: "Last Song", value: dj.data.musicFavorites.lastSong },
          ].map((item) => (
            <div class="text-center p-6">
              <p class="font-body text-eyebrow font-semibold tracking-[0.2em] uppercase text-golden-hour mb-2">
                {item.label}
              </p>
              <p class="font-heading text-xl text-driftwood">
                {item.value}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- DJ-specific reviews -->
  {djReviews.length > 0 && (
    <section class="py-20 md:py-28 lg:py-section">
      <div class="max-w-5xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="Reviews"
          heading={`What people say about ${dj.data.name.split(" ")[0]}.`}
          centered
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
          {djReviews.map(({ entry, ReviewContent }) => (
            <div class="bg-deep-sound rounded-lg p-8">
              <ReviewCard
                attribution={entry.data.attribution}
                eventType={entry.data.eventType}
              >
                <ReviewContent />
              </ReviewCard>
            </div>
          ))}
        </div>
        <div class="text-center mt-10">
          <Button href="/reviews" variant="outline" size="md">
            All reviews
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- Meet the rest -->
  {allDjs.length > 0 && (
    <section class="py-20 md:py-28 lg:py-section bg-deep-sound">
      <div class="max-w-5xl mx-auto px-6" data-reveal>
        <SectionHeading
          eyebrow="The Collective"
          heading="Meet the rest of the crew."
          centered
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
          {allDjs.map((other) => (
            <a
              href={`/djs/${other.id}`}
              class="group block rounded-lg overflow-hidden border border-driftwood/10 hover:border-driftwood/30 transition-colors duration-200"
            >
              <div class="relative h-36 overflow-hidden">
                <PlaceholderArt variant="warm" />
                <div class="absolute inset-0 bg-deep-sound/30" />
              </div>
              <div class="p-5">
                <p class="font-body text-xs font-semibold tracking-[0.2em] uppercase text-golden-hour mb-1">
                  {other.data.role}
                </p>
                <h3 class="font-heading text-xl text-driftwood group-hover:text-golden-hour transition-colors duration-200">
                  {other.data.name}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20 md:py-28 lg:py-section">
    <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
      <h2 class="font-heading text-3xl md:text-section text-penn-cove leading-tight mb-4">
        Check your date.
      </h2>
      <p class="font-body text-body text-deep-sound-700 mb-10">
        Tell us about your event and we&rsquo;ll take it from there.
      </p>
      <Button href="/contact" variant="primary" size="lg">
        Check availability
      </Button>
    </div>
  </section>
</BaseLayout>
