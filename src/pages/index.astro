---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import waveVinyl from "../assets/wave-vinyl-placeholder.svg";
import heroImage from "../assets/photos/party-moment.jpg";

const siteEntry = await getEntry("site", "site");
const site = siteEntry?.data;

const allReviews = await getCollection("reviews");
const featuredEntry = allReviews.find((r) => r.data.featured);
const featured = featuredEntry
  ? { entry: featuredEntry, Content: (await render(featuredEntry)).Content }
  : null;

const description =
  "The Whidbey Island DJ Collective — weddings, school dances, and community events across the Puget Sound. Transparent pricing, named DJs, music that reads the room.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site?.businessName ?? "Whidbey Island DJ Collective",
  description,
  url: "https://whidbeyislanddj.com",
  email: site?.email,
  areaServed: site?.serviceArea,
};
---

<BaseLayout
  title="The Whidbey Island DJ Collective — Music That Reads the Room"
  description={description}
  jsonLd={jsonLd}
  landing
>
  <!-- Full-bleed hero -->
  <div class="relative min-h-dvh flex flex-col">
    <!-- Background photo with overlay -->
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt=""
        class="w-full h-full object-cover"
        widths={[640, 1024, 1536, 2048]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-deep-sound-950/85" />
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center flex-1 px-5 pt-10 pb-6 sm:px-8 sm:pt-14 sm:pb-8">

      <!-- Wordmark -->
      <p class="font-body text-[11px] sm:text-xs text-driftwood-300 tracking-[0.25em] uppercase">
        The Whidbey Island DJ Collective
      </p>

      <!-- Mark -->
      <div class="flex-1 flex items-center justify-center py-4 sm:py-6">
        <img
          src={waveVinyl.src}
          width="400"
          height="400"
          alt="Whidbey Island DJ Collective — vinyl record with rolling wave grooves and island coastline"
          class="w-36 h-36 sm:w-48 sm:h-48 md:w-56 md:h-56"
        />
      </div>

      <!-- Tagline -->
      <p class="font-editorial text-xl sm:text-2xl text-driftwood-100 text-center mb-8 sm:mb-10">
        Music that reads the room.
      </p>

      <!-- Two doors -->
      <nav class="flex items-baseline gap-10 sm:gap-16 mb-8 sm:mb-10" aria-label="Services">
        <a href="/weddings" class="font-heading text-[22px] sm:text-3xl text-driftwood hover:text-golden-hour transition-colors duration-300 px-2 py-1">
          Weddings
        </a>
        <a href="/events" class="group font-heading text-[22px] sm:text-3xl text-driftwood hover:text-golden-hour transition-colors duration-300 px-2 py-1 text-center leading-tight">
          Not weddings
          <span class="block font-body text-[10px] sm:text-[11px] text-driftwood-400/60 group-hover:text-golden-hour/50 tracking-[0.2em] mt-1 transition-colors duration-300">
            dances · parties · corporate
          </span>
        </a>
      </nav>

      <!-- Featured review -->
      {featured && (
        <blockquote class="max-w-[300px] sm:max-w-sm text-center mb-8 sm:mb-10 rounded-lg px-5 py-4 bg-deep-sound-950/40 backdrop-blur-sm border border-driftwood-300/10">
          <div class="font-editorial text-[13px] sm:text-sm text-driftwood-200 italic leading-relaxed line-clamp-3 sm:line-clamp-none [&>p]:m-0">
            <featured.Content />
          </div>
          <footer class="font-body text-[10px] sm:text-xs text-golden-hour mt-3 tracking-[0.2em] uppercase">
            &mdash; {featured.entry.data.attribution}
          </footer>
        </blockquote>
      )}

      <!-- Footer -->
      <footer class="mt-auto pt-4 flex flex-col items-center gap-2 text-center">
        <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1 font-body text-[11px] tracking-wide" aria-label="Footer links">
          <a href="/contact" class="text-driftwood-300/60 hover:text-golden-hour transition-colors">Contact</a>
          <a href="/pricing" class="text-driftwood-300/60 hover:text-golden-hour transition-colors">Pricing</a>
          <a href="/reviews" class="text-driftwood-300/60 hover:text-golden-hour transition-colors">Reviews</a>
          <a href="/privacy" class="text-driftwood-300/60 hover:text-golden-hour transition-colors">Privacy</a>
        </nav>
        <p class="font-body text-[9px] sm:text-[10px] text-driftwood-300/30 tracking-wide">
          &copy; {new Date().getFullYear()} WIDC &middot; Whidbey Island &amp; the Puget Sound
        </p>
      </footer>
    </div>
  </div>
</BaseLayout>
