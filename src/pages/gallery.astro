---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextHero from "../components/TextHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FilterChips from "../components/FilterChips.astro";
import YouTubeFacade from "../components/YouTubeFacade.astro";
import CtaSection from "../components/CtaSection.astro";
import { getVideoId } from "../lib/video";
import { galleryTagLabels } from "../lib/labels";

const allGallery = (await getCollection("gallery")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const pinnedVideos = allGallery.filter((g) => g.data.pinned && g.data.videoUrl);
const gridItems = allGallery.filter((g) => !g.data.pinned);

const hasContent = allGallery.length > 0;

// Build filter chips from tag enum values that actually appear in content.
// "Video" is synthesized from kind (video/reel), not from a tag value.
const usedTags = [...new Set(allGallery.flatMap((g) => g.data.tags))];
const hasVideos = allGallery.some(
  (g) => g.data.kind === "video" || g.data.kind === "reel",
);
const filters = [
  ...usedTags.map((t) => ({ key: t, label: galleryTagLabels[t] ?? t })),
  ...(hasVideos ? [{ key: "video", label: "Video" }] : []),
];
---

<BaseLayout
  title="Gallery | Whidbey Island DJ Collective"
  description="Photos and videos from weddings, school dances, and events across Whidbey Island and the Puget Sound."
>
  <TextHero>
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-6">
      See what we do.
    </h1>
    <p class="font-editorial text-lg text-sea-glass-300 leading-relaxed max-w-xl italic">
      Photos and videos from real events across the island and the Sound.
    </p>
  </TextHero>

  {hasContent ? (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-6xl mx-auto px-6">
        {/* Filters */}
        {filters.length > 1 && (
          <div class="mb-12" data-reveal>
            <FilterChips
              filters={filters}
              target="#gallery-grid"
              filterAttr="filterTags"
            />
          </div>
        )}

        {/* Pinned videos — visible on "All" and "Video" filters, hidden otherwise */}
        {pinnedVideos.length > 0 && (
          <div id="pinned-videos" class="mb-16" data-reveal>
            <SectionHeading eyebrow="Featured" heading="Core videos." />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
              {pinnedVideos.map((item) => {
                const videoId = item.data.videoUrl
                  ? getVideoId(item.data.videoUrl)
                  : null;
                return videoId ? (
                  <YouTubeFacade
                    videoId={videoId}
                    title={item.data.caption ?? "Video"}
                  />
                ) : null;
              })}
            </div>
          </div>
        )}

        {/* Photo/video grid */}
        {gridItems.length > 0 && (
          <div id="gallery-grid" class="columns-2 lg:columns-3 gap-4 space-y-4">
            {gridItems.map((item) => {
              const isVideo =
                item.data.kind === "video" || item.data.kind === "reel";
              const tags = [
                ...item.data.tags,
                ...(isVideo ? ["video"] : []),
              ].join(",");
              const videoId = item.data.videoUrl
                ? getVideoId(item.data.videoUrl)
                : null;

              return (
                <div
                  class="break-inside-avoid"
                  data-filterable
                  data-filter-tags={tags}
                  data-reveal
                >
                  {item.data.kind === "photo" && item.data.image ? (
                    <button
                      type="button"
                      class="block w-full rounded-lg overflow-hidden cursor-zoom-in"
                      data-lightbox-trigger
                      data-lightbox-src={item.data.image}
                      data-lightbox-alt={
                        item.data.alt ?? item.data.caption ?? ""
                      }
                      data-lightbox-caption={item.data.caption ?? ""}
                    >
                      <img
                        src={item.data.image}
                        alt={item.data.alt ?? item.data.caption ?? ""}
                        loading="lazy"
                        class="w-full h-auto object-cover hover:opacity-90 transition-opacity duration-200"
                      />
                    </button>
                  ) : videoId ? (
                    <YouTubeFacade
                      videoId={videoId}
                      title={item.data.caption ?? "Video"}
                    />
                  ) : null}
                </div>
              );
            })}
          </div>
        )}
      </div>
    </section>
  ) : (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-2xl mx-auto px-6 text-center" data-reveal>
        <p class="font-body text-body text-deep-sound-500">
          Gallery coming soon. We&rsquo;re sorting through hundreds of photos
          and videos from the past few seasons.
        </p>
      </div>
    </section>
  )}

  <CtaSection
    heading="Want to see your event here?"
    body="Tell us about your event and we&rsquo;ll take it from there."
    buttonText="Check availability"
  />
</BaseLayout>

<script>
  function initGalleryPinnedToggle() {
    const pinned = document.getElementById("pinned-videos");
    if (!pinned) return;

    const chipContainer = document.querySelector<HTMLElement>(".filter-chips");
    if (!chipContainer) return;

    chipContainer.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(
        ".filter-chip",
      );
      if (!chip) return;
      const value = chip.dataset.filterValue ?? "all";
      pinned.style.display = value === "all" || value === "video" ? "" : "none";
    });
  }

  document.addEventListener("astro:page-load", initGalleryPinnedToggle);

  /* ── Lightweight lightbox ── */
  function initLightbox() {
    // Create overlay once
    let overlay = document.getElementById(
      "gallery-lightbox",
    ) as HTMLDivElement | null;
    if (overlay) overlay.remove();

    overlay = document.createElement("div");
    overlay.id = "gallery-lightbox";
    overlay.className =
      "fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4 cursor-zoom-out";
    overlay.innerHTML = `
      <img id="lightbox-img" class="max-w-full max-h-[90vh] object-contain rounded-lg" alt="" />
      <p id="lightbox-caption" class="absolute bottom-6 left-0 right-0 text-center text-white/80 text-sm font-body px-4"></p>
      <button type="button" id="lightbox-prev" aria-label="Previous" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white text-4xl font-bold px-3 py-2 select-none">&lsaquo;</button>
      <button type="button" id="lightbox-next" aria-label="Next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white text-4xl font-bold px-3 py-2 select-none">&rsaquo;</button>
    `;
    document.body.appendChild(overlay);

    const img = document.getElementById("lightbox-img") as HTMLImageElement;
    const caption = document.getElementById(
      "lightbox-caption",
    ) as HTMLParagraphElement;
    const prevBtn = document.getElementById(
      "lightbox-prev",
    ) as HTMLButtonElement;
    const nextBtn = document.getElementById(
      "lightbox-next",
    ) as HTMLButtonElement;

    // Gather all visible triggers in DOM order
    function getTriggers() {
      return [
        ...document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"),
      ].filter((el) => {
        const parent = el.closest("[data-filterable]");
        return !parent || parent.checkVisibility?.() !== false;
      });
    }

    let currentIndex = 0;

    function show(index: number) {
      const triggers = getTriggers();
      if (index < 0 || index >= triggers.length) return;
      currentIndex = index;
      const trigger = triggers[currentIndex];
      img.src = trigger.dataset.lightboxSrc ?? "";
      img.alt = trigger.dataset.lightboxAlt ?? "";
      caption.textContent = trigger.dataset.lightboxCaption ?? "";
      overlay!.classList.remove("hidden");
      overlay!.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function hide() {
      overlay!.classList.add("hidden");
      overlay!.classList.remove("flex");
      document.body.style.overflow = "";
    }

    function navigate(dir: number) {
      const triggers = getTriggers();
      const next = currentIndex + dir;
      if (next >= 0 && next < triggers.length) show(next);
    }

    // Open on trigger click
    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-lightbox-trigger]",
      );
      if (!trigger) return;
      const triggers = getTriggers();
      const idx = triggers.indexOf(trigger);
      if (idx >= 0) show(idx);
    });

    // Close on overlay click (but not on arrows)
    overlay.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === overlay || target === img || target === caption) hide();
    });

    prevBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      navigate(-1);
    });
    nextBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      navigate(1);
    });

    // Keyboard nav
    document.addEventListener("keydown", (e) => {
      if (overlay!.classList.contains("hidden")) return;
      if (e.key === "Escape") hide();
      if (e.key === "ArrowLeft") navigate(-1);
      if (e.key === "ArrowRight") navigate(1);
    });

    // Swipe support for mobile
    let touchStartX = 0;
    overlay.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
    overlay.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 50) {
        navigate(dx > 0 ? -1 : 1);
      } else {
        hide();
      }
    });
  }

  document.addEventListener("astro:page-load", initLightbox);
</script>
