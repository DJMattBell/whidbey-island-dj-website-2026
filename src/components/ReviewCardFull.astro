---
interface Props {
  attribution: string;
  eventType: string;
  source: string;
  sourceUrl?: string;
  rating?: number;
  date?: string;
}

import { sourceLabels, eventLabels } from "../lib/labels";

const { attribution, eventType, source, sourceUrl, rating, date } =
  Astro.props;

const sourceLabel = sourceLabels[source] ?? source;
const eventLabel = eventLabels[eventType] ?? eventType;
---

<article class="bg-deep-sound rounded-lg p-8">
  <!-- Rating stars -->
  {rating && (
    <div class="flex gap-1 mb-4" aria-label={`${rating} out of 5 stars`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg
          class:list={["w-4 h-4", i < rating ? "text-golden-hour" : "text-deep-sound-600"]}
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>
  )}

  <!-- Quote body -->
  <blockquote class="mb-6">
    <div class="font-body text-body text-driftwood-200 leading-relaxed [&>p]:mb-3 [&>p:last-child]:mb-0">
      <slot />
    </div>
  </blockquote>

  <!-- Attribution + meta -->
  <footer class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="font-body text-small font-semibold text-golden-hour tracking-wide uppercase">
      &mdash; {attribution}
    </span>
    <span class="font-body text-xs text-driftwood-400">
      {eventLabel}
    </span>
    {date && (
      <span class="font-body text-xs text-driftwood-500">
        {date}
      </span>
    )}
  </footer>

  <!-- Source link -->
  {source !== "direct" && (
    <div class="mt-4 pt-4 border-t border-driftwood/10">
      {sourceUrl ? (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-sm text-sea-glass hover:text-sea-glass-300 transition-colors duration-200"
        >
          Read on {sourceLabel} &rarr;
        </a>
      ) : (
        <span class="font-body text-sm text-driftwood-500">
          via {sourceLabel}
        </span>
      )}
    </div>
  )}
</article>
