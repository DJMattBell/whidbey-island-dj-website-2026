---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextHero from "../components/TextHero.astro";
import CtaSection from "../components/CtaSection.astro";
import SectionHeading from "../components/SectionHeading.astro";

const allEquipment = (await getCollection("equipment"))
  .filter((e) => e.data.category === "lighting")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// Split lighting into ambiance and dance floor groups
const ambianceIds = [
  "freedom-h9-ip-uplights",
  "wash-fx-hex-ils",
  "obsession-hp",
  "flexstand-fx-ils",
  "freedom-flex-stick-x4",
];

const ambiance = allEquipment.filter((e) => ambianceIds.includes(e.id));
const danceFloor = allEquipment.filter((e) => !ambianceIds.includes(e.id));

type EquipmentWithContent = {
  entry: (typeof allEquipment)[number];
  Content: Awaited<ReturnType<typeof render>>["Content"];
};

const renderGroup = async (
  items: typeof allEquipment,
): Promise<EquipmentWithContent[]> =>
  Promise.all(
    items.map(async (entry) => {
      const { Content } = await render(entry);
      return { entry, Content };
    }),
  );

const ambianceWithContent = await renderGroup(ambiance);
const danceFloorWithContent = await renderGroup(danceFloor);
---

<BaseLayout
  title="Our Lighting | Whidbey Island DJ Collective"
  description="Every light we bring to your event. Wireless uplights, wash effects, gobos, dance floor effects, LED sticks, and more — see the full rig."
>
  <TextHero>
    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-driftwood leading-[0.95] mb-6">
      Our lighting rig.
    </h1>
    <p class="font-editorial text-lg text-sea-glass-300 leading-relaxed max-w-xl italic">
      Everything listed here comes with us to your event. This page is a
      reference &mdash; send it to anyone who asks what lighting we have.
    </p>
  </TextHero>

  <!-- Ambiance lighting -->
  {ambianceWithContent.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section bg-deep-sound-900">
      <div class="max-w-5xl mx-auto px-6">
        <SectionHeading
          eyebrow="Ambiance"
          heading="Set the mood before the first guest arrives."
        />
        <p class="font-body text-sm text-driftwood-300 mt-4 mb-12 max-w-2xl">
          Uplights, washes, gobos, and accent lighting that transform your
          venue. These run all night &mdash; subtle color during dinner,
          dialed up when the party starts.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {ambianceWithContent.map(({ entry, Content }) => (
            <article class="rounded-lg overflow-hidden bg-deep-sound-800" data-reveal>
              {entry.data.photo && (
                <div class="relative aspect-[16/9] overflow-hidden">
                  <Image
                    src={entry.data.photo}
                    alt={entry.data.name}
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}
              <div class="p-6">
                <h3 class="font-heading text-xl text-driftwood leading-tight mb-2">
                  {entry.data.name}
                </h3>
                <p class="font-body text-sm text-sea-glass-300 mb-4">
                  {entry.data.whatItDoes}
                </p>
                <div class="font-body text-sm text-driftwood-300 leading-relaxed [&>p]:mb-2 [&>p:last-child]:mb-0">
                  <Content />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dance floor lighting -->
  {danceFloorWithContent.length > 0 && (
    <section class="py-28 md:py-36 lg:py-section">
      <div class="max-w-5xl mx-auto px-6">
        <SectionHeading
          eyebrow="Dance Floor"
          heading="Light up the party."
          dark={false}
        />
        <p class="font-body text-sm text-deep-sound-500 mt-4 mb-12 max-w-2xl">
          Beams, lasers, strobes, and mirror ball effects that make the
          dance floor feel alive. These come out when the music picks up.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {danceFloorWithContent.map(({ entry, Content }) => (
            <article class="rounded-lg overflow-hidden bg-deep-sound-900" data-reveal>
              {entry.data.photo && (
                <div class="relative aspect-[16/9] overflow-hidden">
                  <Image
                    src={entry.data.photo}
                    alt={entry.data.name}
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}
              <div class="p-6">
                <h3 class="font-heading text-xl text-driftwood leading-tight mb-2">
                  {entry.data.name}
                </h3>
                <p class="font-body text-sm text-sea-glass-300 mb-4">
                  {entry.data.whatItDoes}
                </p>
                <div class="font-body text-sm text-driftwood-300 leading-relaxed [&>p]:mb-2 [&>p:last-child]:mb-0">
                  <Content />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection
    heading="Questions about our setup?"
    body="We&rsquo;re happy to walk you through what we bring and how it fits your venue."
    buttonText="Get in touch"
  />
</BaseLayout>
