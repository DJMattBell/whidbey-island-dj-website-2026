---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaSection from "../../components/CtaSection.astro";
import { blogCategoryLabels } from "../../lib/labels";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | Whidbey Island DJ Collective`}
  description={post.data.excerpt}
>
  <!-- Post header -->
  <section class="py-40 md:py-52 lg:py-64 bg-deep-sound-900">
    <div class="max-w-3xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-6">
        <span class="font-body text-xs font-semibold tracking-[0.2em] uppercase text-golden-hour">
          {blogCategoryLabels[post.data.category]}
        </span>
        <span class="font-body text-xs text-sea-glass-300">
          {formatDate(post.data.publishedAt)}
        </span>
      </div>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-driftwood leading-[0.95] mb-6">
        {post.data.title}
      </h1>
      <p class="font-editorial text-lg text-sea-glass-300 leading-relaxed italic max-w-xl">
        {post.data.excerpt}
      </p>
    </div>
  </section>

  {/* Cover image */}
  {post.data.coverImage && (
    <section class="bg-deep-sound-900 pb-12">
      <div class="max-w-4xl mx-auto px-6">
        <img src={post.data.coverImage} alt={post.data.title} class="w-full rounded-lg" />
      </div>
    </section>
  )}

  <!-- Post body -->
  <section class="py-28 md:py-36 lg:py-section">
    <div class="max-w-3xl mx-auto px-6">
      <div
        class="prose prose-lg max-w-none font-body text-deep-sound-700 leading-relaxed space-y-6
        [&>p]:text-body [&>p]:leading-relaxed
        [&>h2]:font-heading [&>h2]:text-2xl [&>h2]:text-penn-cove [&>h2]:mt-12 [&>h2]:mb-4
        [&>h3]:font-heading [&>h3]:text-xl [&>h3]:text-penn-cove [&>h3]:mt-8 [&>h3]:mb-3
        [&>blockquote]:border-l-2 [&>blockquote]:border-golden-hour [&>blockquote]:pl-6 [&>blockquote]:italic [&>blockquote]:text-deep-sound-500"
      >
        <Content />
      </div>
      <div class="mt-16 pt-8 border-t border-deep-sound/10">
        <a
          href="/blog"
          class="font-body text-sm text-penn-cove hover:text-golden-hour transition-colors duration-200"
        >
          &larr; Back to blog
        </a>
      </div>
    </div>
  </section>

  <CtaSection
    heading="Like what you read?"
    body="We&rsquo;d love to hear about your event."
    buttonText="Get in touch"
  />
</BaseLayout>
