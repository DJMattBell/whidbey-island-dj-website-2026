---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TextHero from "../components/TextHero.astro";

const siteEntry = await getEntry("site", "site");
const email = siteEntry?.data.email ?? "matt@whidbeyislanddj.com";
---

<BaseLayout
  title="Terms of Service | Whidbey Island DJ Collective"
  description="Terms of service for the Whidbey Island DJ Collective website."
>
  <TextHero>
    <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-driftwood leading-[0.95]">
      Terms of Service
    </h1>
  </TextHero>

  <section class="py-28 md:py-36 lg:py-section">
    <div
      class="max-w-3xl mx-auto px-6 font-body text-body text-deep-sound-700 leading-relaxed space-y-6
      [&>h2]:font-heading [&>h2]:text-xl [&>h2]:text-penn-cove [&>h2]:mt-10 [&>h2]:mb-3"
    >
      <p>
        <strong>Last updated:</strong> October 2026
      </p>

      <p>
        By using this website you agree to these terms. If you don&rsquo;t
        agree, please don&rsquo;t use the site.
      </p>

      <h2>Use of this site</h2>
      <p>
        This website is provided for informational purposes about the Whidbey
        Island DJ Collective and our services. You may browse the site and use
        the contact form to reach us. You may not use the site for any unlawful
        purpose or in a way that could damage or impair it.
      </p>

      <h2>Content ownership</h2>
      <p>
        All content on this site &mdash; text, photos, videos, and design
        &mdash; is owned by the Whidbey Island DJ Collective unless otherwise
        noted. You may not reproduce, distribute, or use our content without
        written permission.
      </p>

      <h2>Pricing and availability</h2>
      <p>
        Prices shown on this site are estimates and may change. Final pricing is
        confirmed in your event contract. Availability is subject to booking.
      </p>

      <h2>Limitation of liability</h2>
      <p>
        This site is provided &ldquo;as is.&rdquo; We make no warranties about
        the accuracy or completeness of the content. We are not liable for any
        damages arising from your use of this site.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about these terms? Email us at
        <a
          href={`mailto:${email}`}
          class="text-penn-cove hover:text-golden-hour underline transition-colors duration-200"
        >
          {email}
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>
