---
interface Props {
  eyebrow?: string;
  heading: string;
  centered?: boolean;
}

const { eyebrow, heading, centered = false } = Astro.props;
---

<div class:list={["mb-10", centered && "text-center"]}>
  {eyebrow && (
    <span class="block font-body text-eyebrow font-semibold tracking-[0.2em] uppercase text-golden-hour mb-3">
      {eyebrow}
    </span>
  )}
  <h2 class="font-heading text-3xl md:text-section text-penn-cove leading-tight">
    {heading}
  </h2>
</div>
